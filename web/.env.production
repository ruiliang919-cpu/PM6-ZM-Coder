# 页面标题
VUE_APP_TITLE = PM6ZM后台管理系统

# 生产环境配置
ENV = 'production'

# 若依管理系统/生产环境
#VUE_APP_BASE_API = 'http://zm.rdhkj.com/prod-api'
VUE_APP_BASE_API = 'http://127.0.0.1/prod-api'
#VUE_APP_BASE_API = '/prod-api'

# 应用访问路径 例如使用前缀 /admin/
VUE_APP_CONTEXT_PATH = '/'

# 监控地址
VUE_APP_MONITRO_ADMIN = '/admin/applications'

# xxl-job 控制台地址
VUE_APP_XXL_JOB_ADMIN = '/xxl-job-admin'
ELECTRON_NODE_INTEGRATION = true

